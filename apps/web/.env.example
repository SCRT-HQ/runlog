# Copy to apps/web/.env.local (ignored by git) for local development.

# The staging WorkOS client id: "Sign in" appears in the header, and
# http://localhost:5173/ is a registered callback. Absent: no sign-in.
VITE_WORKOS_CLIENT_ID=

# A hosted Runlog to stand in front of: the dev server proxies /api and /ws
# there, so live links, widgets by link, sync and purchases work at
# localhost. Absent: the local copy has no API, like a copy on disk.
VITE_RUNLOG_API_ORIGIN=https://runlog.dev.scrthq.com
