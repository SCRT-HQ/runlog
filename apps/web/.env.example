# Copy to apps/web/.env.local (ignored by git) for local development.

# A WorkOS client id with http://localhost:5173/ as a registered callback:
# "Sign in" appears in the header. Absent: no sign-in.
VITE_WORKOS_CLIENT_ID=

# A hosted Runlog to stand in front of, yours or a staging copy of it: the
# dev server proxies /api and /ws there, so live links, widgets by link,
# sync and purchases work at localhost against that copy's data. Absent:
# the local copy has no API, like a copy on disk.
VITE_RUNLOG_API_ORIGIN=
