  "Actions": [
    {
      "Name": "Next action",
      "UUID": "com.scrthq.runlog.next",
      "Icon": "imgs/actions/next",
      "Tooltip": "Presses whatever the run is waiting on, and takes the decisions unless told to stop.",
      "Controllers": ["Keypad", "Encoder"],
      "Encoder": { "layout": "$B1" },
      "States": [{ "Image": "imgs/keys/next" }],
      "PropertyInspectorPath": "ui/next.html"
    },
    {
      "Name": "Press",
      "UUID": "com.scrthq.runlog.press",
      "Icon": "imgs/actions/press",
      "Tooltip": "One move, the waiting roll, or a preset answer.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/keys/press" }],
      "PropertyInspectorPath": "ui/press.html"
    },
    {
      "Name": "Roll",
      "UUID": "com.scrthq.runlog.roll",
      "Icon": "imgs/actions/roll",
      "Tooltip": "Throws the dice the run is waiting on.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/keys/roll" }],
      "PropertyInspectorPath": "ui/roll.html"
    },
    {
      "Name": "Undo",
      "UUID": "com.scrthq.runlog.undo",
      "Icon": "imgs/actions/undo",
      "Tooltip": "Takes back the last result.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/keys/undo" }],
      "PropertyInspectorPath": "ui/undo.html"
    },
    {
      "Name": "Run",
      "UUID": "com.scrthq.runlog.run",
      "Icon": "imgs/actions/run",
      "Tooltip": "Which run the deck is on. Press to switch.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/keys/run" }],
      "PropertyInspectorPath": "ui/run.html"
    },
    {
      "Name": "Connect",
      "UUID": "com.scrthq.runlog.connect",
      "Icon": "imgs/actions/connect",
      "Tooltip": "Connects the deck to your Runlog account, and disconnects it again.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/keys/connect" }],
      "PropertyInspectorPath": "ui/connect.html"
    },
    {
      "Name": "Metric",
      "UUID": "com.scrthq.runlog.metric",
      "Icon": "imgs/actions/metric",
      "Tooltip": "A number from the run: score, unit, clock, last result.",
      "Controllers": ["Keypad", "Encoder"],
      "Encoder": { "layout": "$B1" },
      "States": [{ "Image": "imgs/keys/metric" }],
      "PropertyInspectorPath": "ui/metric.html"
    },
    {
      "Name": "Apply setup",
      "UUID": "com.scrthq.runlog.setup",
      "Icon": "imgs/actions/setup",
      "Tooltip": "Changes the run's loadout to this setup and hands it out to the tool.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/keys/setup" }],
      "PropertyInspectorPath": "ui/setup.html"
    },
    {
      "Name": "Open in the browser",
      "UUID": "com.scrthq.runlog.open",
      "Icon": "imgs/actions/open",
      "Tooltip": "Opens the run, the guide, or the pack's rules in your browser.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/keys/open" }],
      "PropertyInspectorPath": "ui/open.html"
    }
  ]
}
