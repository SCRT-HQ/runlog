# Nothing younger than a week. A package version published less than seven
# days ago is not installed by `npm install` or `npm update`; a lockfile
# already written is not affected, so `npm ci` is as it was. The week is
# the window in which a compromised release is usually noticed and pulled.
# Our own packages are exempt: a release of ours is ours to trust today.
# Enforced by npm 11.10 and later; an older npm reads the line and does
# nothing with it. Dependabot has the same week as its cooldown.
min-release-age=7
min-release-age-exclude=@scrthq/*
