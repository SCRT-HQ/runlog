{
  "name": "@runlog/infra",
  "version": "0.1.0",
  "private": true,
  "description": "The AWS hosting for Runlog: the API, the site, and the pages that make an address a service.",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=junit.xml",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1127.0",
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-secrets-manager": "^3.1127.0",
    "@aws-sdk/client-sesv2": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^22.7.9",
    "aws-cdk": "^2.1140.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@workos-inc/node": "^10.13.0",
    "aws-cdk-lib": "^2.268.0",
    "aws-jwt-verify": "^5.2.1",
    "cdk-nag": "^2.38.2",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21",
    "stripe": "^22.6.1",
    "yaml": "^2.9.0"
  }
