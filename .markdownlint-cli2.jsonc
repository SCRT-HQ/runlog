// Style for the Markdown in this repository, so it stays consistent without
// anyone having to remember the rules. `npm run lint:docs` checks, and
// `npm run lint:docs -- --fix` fixes what can be fixed mechanically.
//
// The one that matters: MD013 is off. A paragraph is written as one line and
// the editor wraps it. Reflowing prose to a fill column makes a one-word edit
// touch the whole paragraph, which buries the change in the diff.
{
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/cdk.out/**",
    "packages/cli/stage/**",
    // Generated by `npm run docs:emit`; its shape is the generator's to set.
    "docs/reference.md",
    // Scratch notes, not documentation.
    ".remember/**",
    // Task reports from SDD plan execution; gitignored by their own
    // .superpowers/sdd/.gitignore, and not documentation either.
    ".superpowers/sdd/**",
  ],
  "config": {
    "default": true,

    // One line per paragraph. No fill column.
    "MD013": false,

    // The README opens with a badge row, and a few figures are HTML.
    "MD033": false,
    "MD041": false,

    // A heading may repeat under a different section; the docs are read by section.
    "MD024": { "siblings_only": true },
  },
}
